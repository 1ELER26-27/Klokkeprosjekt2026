        "${userHome}/.arduino15/packages/esp32/hardware/esp32/**/libraries/**",
        "${userHome}/.arduino15/packages/esp32/tools/**/include/**",
        "${userHome}/Arduino/libraries/**",
        "${userHome}/AppData/Local/Arduino15/packages/esp32/hardware/esp32/**/cores/esp32",
        "${userHome}/AppData/Local/Arduino15/packages/esp32/hardware/esp32/**/variants/esp32",
        "${userHome}/AppData/Local/Arduino15/packages/esp32/hardware/esp32/**/libraries/**",
        "${userHome}/AppData/Local/Arduino15/packages/esp32/tools/**/include/**",
        "${userHome}/Documents/Arduino/libraries/**"
